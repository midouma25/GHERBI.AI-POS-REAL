  transform: scale(1.1);
}

/* 3. الزر الشريطي الذكي للزبون والوفاء (بدل الصناديق الضخمة) */
.gherbi-smart-customer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.4rem;
  padding: 0.35rem 0.6rem;
  background: var(--bg-surface);
  border-bottom: 1px solid var(--border-color);
  flex-shrink: 0;
}

.gherbi-loyalty-trigger-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.38rem 0.65rem;
  border-radius: 0.6rem;
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.12) 0%, rgba(37, 99, 235, 0.08) 100%);
  border: 1.5px solid rgba(245, 158, 11, 0.4);
  color: var(--text-main);
  font-size: 11.5px;
  font-weight: 800;
  text-align: right;
  transition: all 0.15s ease;
}
.gherbi-loyalty-trigger-btn:hover {
  border-color: #f59e0b;
  box-shadow: 0 3px 10px rgba(245, 158, 11, 0.15);
}

/* 4. شريط مضاعفات الكمية السريع والبيع بمبلغ */
.gherbi-multiplier-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.35rem;
  padding: 0.28rem 0.6rem;
  background: var(--bg-main);
  border-bottom: 1px solid var(--border-color);
  flex-shrink: 0;
}
.gherbi-mult-pill {
  padding: 0.15rem 0.5rem;
  border-radius: 0.4rem;
  font-family: var(--font-numbers);
  font-size: 11px;
  font-weight: 900;
  border: 1px solid var(--border-color);
  background: var(--bg-surface);
  color: var(--text-main);
  transition: all 0.12s ease;
}
.gherbi-mult-pill.active {
  background: #2563eb !important;
  color: #ffffff !important;
  border-color: #1d4ed8 !important;
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.25);
}

/* 5. تعظيم مساحة مستطيل المشتريات (#posCartItems) */
#posCartItems {
  flex: 1 1 0% !important;
  min-height: 210px !important;
  overflow-y: auto !important;
  padding: 0.45rem 0.55rem !important;
}

/* تنسيق مضغوط وأنيق لكل سطر داخل السلة مع شارة المخزون */
#posCartItems > div {
  padding: 0.4rem 0.6rem !important;
  border-radius: 0.65rem !important;
  margin-bottom: 0.35rem !important;
  border: 1px solid var(--border-color) !important;
  transition: all 0.12s ease !important;
}
#posCartItems > div.gherbi-row-selected {
  border-color: #2563eb !important;
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.18) !important;
}
#posCartItems > div.gherbi-cost-warning-row {
  border-color: #ef4444 !important;
  background: rgba(239, 68, 68, 0.07) !important;
}

.gherbi-stock-forecast-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 10px;
  font-weight: 800;
  padding: 1px 6px;
  border-radius: 0.35rem;
  margin-top: 2px;
}
.stock-safe { background: rgba(16, 185, 129, 0.12); color: #059669; }
.stock-low { background: rgba(245, 158, 11, 0.15); color: #d97706; }
.stock-critical { background: rgba(239, 68, 68, 0.15); color: #dc2626; }
html.dark .stock-safe { color: #34d399; }
html.dark .stock-low { color: #fbbf24; }
html.dark .stock-critical { color: #f87171; }

/* 6. قسم الدفع السفلي المضغوط + حاسبة الصرف السريعة */
.gherbi-compact-footer {
  padding: 0.45rem 0.65rem !important;
  background: var(--bg-surface) !important;
  border-top: 1.5px solid var(--border-color) !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 0.35rem !important;
  flex-shrink: 0 !important;
}

.gherbi-quick-change-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.3rem;
  padding: 0.25rem 0.45rem;
  border-radius: 0.5rem;
  background: var(--bg-main);
  border: 1px solid var(--border-color);
  font-size: 10.5px;
}
.gherbi-banknote-btn {
  padding: 1px 6px;
  border-radius: 0.35rem;
  background: rgba(16, 185, 129, 0.12);
  color: #059669;
  border: 1px solid rgba(16, 185, 129, 0.3);
  font-family: var(--font-numbers);
  font-weight: 900;
  font-size: 10px;
}
.gherbi-banknote-btn:hover {
  background: #10b981;
  color: #ffffff;
}

/* 7. وضع الإرجاع النشط */
#btnReturnMode.return-mode-active {
  background: #dc2626 !important;
  color: #ffffff !important;
  border-color: #b91c1c !important;
  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.3) !important;
  animation: pulseReturn 1.4s infinite;
}
@keyframes pulseReturn {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

/* 8. خيار تحويل القائمة الجانبية (#sidebar) إلى شريط تنقل علوي أفقي (Top Navbar Mode) */
body.gherbi-top-nav-mode .app-shell {
  flex-direction: column !important;
}
body.gherbi-top-nav-mode #sidebar {
  width: 100% !important;
  height: auto !important;
  max-height: 50px !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: space-between !important;
  padding: 0.25rem 0.75rem !important;
  border-left: none !important;
  border-bottom: 1px solid #1e293b !important;
  overflow-x: auto !important;
  overflow-y: hidden !important;
  flex-shrink: 0 !important;
}
body.gherbi-top-nav-mode #sidebar > div:first-child {
  padding: 0 !important;
  border: none !important;
  margin-left: 0.75rem !important;
  flex-shrink: 0 !important;
}
body.gherbi-top-nav-mode #sidebar nav,
body.gherbi-top-nav-mode #sidebar .sidebar-nav,
body.gherbi-top-nav-mode #sidebar > div:nth-child(2) {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 0.25rem !important;
  overflow-x: auto !important;
  padding: 0 !important;
  flex: 1 !important;
}
body.gherbi-top-nav-mode #sidebar .nav-section-title,
body.gherbi-top-nav-mode #sidebar p.text-xs,
body.gherbi-top-nav-mode #sidebar .uppercase {
  display: none !important;
}
body.gherbi-top-nav-mode #sidebar .nav-item,
body.gherbi-top-nav-mode #sidebar button {
  padding: 0.3rem 0.6rem !important;
  font-size: 11px !important;
  white-space: nowrap !important;
  margin: 0 !important;
  width: auto !important;
}
body.gherbi-top-nav-mode #view-pos .pos-layout {
  height: calc(100vh - var(--header-height) - 58px) !important;
}
