/* ==========================================================================
   GHERBI.AI POS — 12 CORE ENGINEERING UPGRADES (SURGICAL UI/UX ENHANCEMENTS)
   ========================================================================== */

/* 1. تخطيط شاشة المبيعات القابل للسحب وتغيير الحجم ديناميكياً (Smooth Resizable Split-Pane) */
#view-pos .pos-layout {
  display: flex !important;
  flex-direction: row !important;
  align-items: stretch !important;
  gap: 0 !important;
  height: calc(100vh - var(--header-height) - 1.5rem) !important;
  min-height: 0 !important;
  position: relative !important;
}

/* القسم الأيمن (المنتجات) يأخذ المساحة المتبقية بمرونة */
#view-pos .pos-layout > div:first-child {
  flex: 1 1 0% !important;
  min-width: 320px !important;
  padding-left: 0.35rem !important;
  overflow: hidden !important;
}

/* مقبض السحب الديناميكي الفاصل بين النصف الأيمن والنصف الأيسر */
.gherbi-split-resizer {
  width: 10px;
  cursor: col-resize;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 35;
  user-select: none;
  flex-shrink: 0;
  margin: 0 2px;
}
.gherbi-split-resizer::before {
  content: '';
  width: 3px;
  height: 100%;
  border-radius: 999px;
  background: var(--border-color);
  transition: all 0.15s ease;
}
.gherbi-split-resizer::after {
  content: '⋮';
  position: absolute;
  width: 16px;
  height: 44px;
  border-radius: 999px;
  background: var(--bg-surface);
  border: 1.5px solid var(--border-color);
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
  transition: all 0.15s ease;
}
.gherbi-split-resizer:hover::before,
.gherbi-split-resizer.is-dragging::before {
  background: #2563eb;
  width: 4px;
}
.gherbi-split-resizer:hover::after,
.gherbi-split-resizer.is-dragging::after {
  background: #2563eb;
  border-color: #1d4ed8;
  color: #ffffff;
  transform: scale(1.08);
}

/* النصف الأيسر (لوحة السلة والكاشير) بعرض ديناميكي يتحكم فيه المؤشر */
#view-pos .cart-container {
  width: var(--gherbi-cart-width, 460px) !important;
  min-width: 340px !important;
  max-width: 68vw !important;
  flex-shrink: 0 !important;
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
  overflow: hidden !important;
}

/* 2. شريط السلات المتعددة العلوي المدمج مع زر الحذف ✕ */
.gherbi-compact-carts-header {
  display: flex;
  align-items: center;
